        },
        "gitTools.ai.language": {
          "type": "string",
          "default": "",
          "description": "Language of generated messages (e.g. English, Vietnamese). Empty follows the repository history."
        },
        "gitTools.ai.instructions": {
          "type": "string",
          "default": "",
